[preset.0]
name="Windows Desktop"
platform="Windows Desktop"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter="data/*.json,presentation/*.wav"
exclude_filter="tests/*,*.in"
export_path="../release/ArenaDuel.exe"
script_export_mode=2

[preset.0.options]
custom_template/debug="@DEBUG@"
custom_template/release="@RELEASE@"
debug/export_console_wrapper=0
binary_format/embed_pck=false
binary_format/architecture="x86_64"
codesign/enable=false
application/modify_resources=false

[preset.1]
name="Windows Acceptance"
platform="Windows Desktop"
runnable=false
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter="data/*.json,presentation/*.wav"
exclude_filter="*.in"
export_path="../artifacts/acceptance-build/ArenaDuel.exe"
script_export_mode=2

[preset.1.options]
custom_template/debug="@DEBUG@"
custom_template/release="@RELEASE@"
debug/export_console_wrapper=0
binary_format/embed_pck=false
binary_format/architecture="x86_64"
codesign/enable=false
application/modify_resources=false
